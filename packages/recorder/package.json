{
  "name": "@pathminty/recorder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pathminty/contracts": "workspace:*",
    "@rrweb/record": "2.1.1",
    "rrweb": "2.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^3.2.7"
  }
}
