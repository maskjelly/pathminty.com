{
  "name": "@pathminty/analytics-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "deploy:dry": "wrangler deploy --dry-run --env= --outdir dist",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev --local",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pathminty/analytics": "workspace:*",
    "@pathminty/cloudflare": "workspace:*",
    "@pathminty/contracts": "workspace:*",
    "@pathminty/observability": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "wrangler": "4.120.1"
  }
}
