{
  "name": "@pathminty/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "deploy:development": "wrangler deploy --env=",
    "deploy:dry": "wrangler deploy --dry-run --env=",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "vite",
    "lint": "eslint src vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pathminty/contracts": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrweb": "2.1.1",
    "rrweb-player": "2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.7",
    "wrangler": "4.120.1"
  }
}
