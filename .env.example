# Neon Postgres. `neon env pull` writes real values to ignored `.env.local`.
# Application traffic uses the pooled URL; migrations use the direct URL.
DATABASE_URL=postgresql://user:password@host-pooler/pathminty?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/pathminty?sslmode=require

# Shopify gateway. Create a new Shopify app; never reuse Buyan credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_orders,read_customer_events,read_pixels,write_pixels
